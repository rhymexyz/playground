---
interface Props {
  title: string;
  eyebrow?: string;
  tagline: string;
  intro: string[];
}

const { title, eyebrow, tagline, intro } = Astro.props;
---

<section class="hero">
  <div class="container hero-grid hero-grid-single">
    <div>
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      <p class="tagline">{tagline}</p>
      <div class="hero-copy flow">
        {intro.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </div>
</section>
