---
interface Props {
  title: string;
  intro?: string;
  actionHref?: string;
  actionLabel?: string;
}

const { title, intro, actionHref, actionLabel } = Astro.props;
---

<div class="section-heading">
  <div>
    <h2>{title}</h2>
    {intro && <p>{intro}</p>}
  </div>

  {actionHref && actionLabel && (
    <a class="text-link" href={actionHref}>
      {actionLabel}
    </a>
  )}
</div>
