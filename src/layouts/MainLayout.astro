---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { siteData } from "../data/site";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = siteData.name,
  description = siteData.description,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400&family=Nunito:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <div class="page-shell">
      <Header />
      <main id="content">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

<script>
(async () => {
const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

/* ── 2. Ink-drop cursor trail ──────────────────────────────── */
if (!reduced && window.matchMedia('(pointer: fine)').matches) {
  const canvas = document.createElement('canvas');
  canvas.style.cssText = 'position:fixed;inset:0;pointer-events:none;z-index:9999;';
  document.body.appendChild(canvas);
  const ctx = canvas.getContext('2d')!;

  let W = canvas.width = window.innerWidth;
  let H = canvas.height = window.innerHeight;
  window.addEventListener('resize', () => {
    W = canvas.width = window.innerWidth;
    H = canvas.height = window.innerHeight;
  });

  interface Drop { x: number; y: number; r: number; alpha: number; }
  const drops: Drop[] = [];

  window.addEventListener('mousemove', (e) => {
    drops.push({ x: e.clientX, y: e.clientY, r: Math.random() * 2.5 + 1.5, alpha: 0.18 });
    if (drops.length > 40) drops.shift();
  });

  function loop() {
    ctx.clearRect(0, 0, W, H);
    for (let i = drops.length - 1; i >= 0; i--) {
      const d = drops[i];
      d.alpha -= 0.022;
      d.r += 0.3;
      if (d.alpha <= 0) { drops.splice(i, 1); continue; }
      ctx.beginPath();
      ctx.arc(d.x, d.y, d.r, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(140, 120, 80, ${d.alpha})`;
      ctx.fill();
    }
    requestAnimationFrame(loop);
  }
  loop();
}

/* ── 5. Section scroll reveal ──────────────────────────────── */
if (!reduced) {
  const revealEls = document.querySelectorAll('.home-section, .page-section');
  revealEls.forEach(el => el.classList.add('reveal'));

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('revealed'); observer.unobserve(e.target); } });
  }, { threshold: 0.08 });

  revealEls.forEach(el => observer.observe(el));
}

/* ── 6. Typewriter for "Hi, I'm Joy." + intro paragraphs ──── */
if (!reduced) {
  const h1 = document.querySelector('h1');
  if (h1 && h1.textContent?.trim() === "Hi, I'm Joy.") {
    const sessionKey = 'typewriter-done';
    if (!sessionStorage.getItem(sessionKey)) {

      // inject blink keyframe once
      const blink = document.createElement('style');
      blink.textContent = '@keyframes blink { 0%,100%{opacity:1} 50%{opacity:0} }';
      document.head.appendChild(blink);

      // hide intro paragraphs until h1 finishes
      const introParagraphs = Array.from(
        h1.closest('.container, section')?.querySelectorAll('p.tagline') ?? []
      ) as HTMLElement[];
      introParagraphs.forEach(p => { p.style.opacity = '0'; });

      // helper: type a string into an element, return promise when done
      function typeInto(el: HTMLElement, text: string, speed = 28): Promise<void> {
        return new Promise(resolve => {
          const cursor = document.createElement('span');
          cursor.textContent = '|';
          cursor.style.cssText = 'animation:blink 0.9s step-end infinite;font-weight:300;';
          el.appendChild(cursor);
          let i = 0;
          const tick = () => {
            if (i < text.length) {
              cursor.before(text[i++]);
              setTimeout(tick, speed + Math.random() * 20);
            } else {
              setTimeout(() => { cursor.remove(); resolve(); }, 600);
            }
          };
          tick();
        });
      }

      // type h1 first
      const h1Text = h1.textContent!;
      h1.textContent = '';
      await typeInto(h1, h1Text, 55);

      // then type each intro paragraph sequentially
      for (const p of introParagraphs) {
        const text = p.textContent ?? '';
        p.textContent = '';
        p.style.opacity = '1';
        await typeInto(p, text, 12);
      }

      sessionStorage.setItem(sessionKey, '1');
    }
  }
}
})();
</script>

<style is:global>
  @import "../styles/organic.css";
  @import "../styles/interactions.css";

  .page-shell::before,
  .page-shell::after {
    display: none !important;
  }

  @media (min-width: 48rem) {
    .grid-projects-detail,
    .grid-writing {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .grid-projects-detail,
    .grid-writing {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
