---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { siteData } from "../data/site";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = siteData.name,
  description = siteData.description,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400&family=Nunito:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <div class="scroll-bg" aria-hidden="true">
      <div class="scroll-blob scroll-blob-1"></div>
      <div class="scroll-blob scroll-blob-2"></div>
      <div class="scroll-blob scroll-blob-3"></div>
    </div>
    <div class="page-shell">
      <Header />
      <main id="content">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

<script>
(async () => {
const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

/* ── 1. Scroll background blobs ───────────────────────────── */
if (!reduced) {
  const b1 = document.querySelector<HTMLElement>('.scroll-blob-1');
  const b2 = document.querySelector<HTMLElement>('.scroll-blob-2');
  const b3 = document.querySelector<HTMLElement>('.scroll-blob-3');
  window.addEventListener('scroll', () => {
    const y = window.scrollY;
    if (b1) b1.style.transform = `translateY(${y * 0.18}px)`;
    if (b2) b2.style.transform = `translateY(${-y * 0.12}px)`;
    if (b3) b3.style.transform = `translateY(${y * 0.08}px)`;
  }, { passive: true });
}

/* ── 2. Single ghost cursor dot (no trail) ─────────────────── */
if (!reduced && window.matchMedia('(pointer: fine)').matches) {
  const dot = document.createElement('div');
  dot.style.cssText = `
    position: fixed; pointer-events: none; z-index: 9999;
    width: 10px; height: 10px; border-radius: 50%;
    background: rgba(140, 120, 80, 0.12);
    transform: translate(-50%, -50%);
    transition: left 0.45s cubic-bezier(0.22,1,0.36,1),
                top  0.45s cubic-bezier(0.22,1,0.36,1),
                opacity 0.6s ease;
    opacity: 0;
  `;
  document.body.appendChild(dot);

  let visible = false;
  let hideTimer: ReturnType<typeof setTimeout>;

  window.addEventListener('mousemove', (e) => {
    dot.style.left = e.clientX + 'px';
    dot.style.top  = e.clientY + 'px';
    if (!visible) { dot.style.opacity = '1'; visible = true; }
    clearTimeout(hideTimer);
    hideTimer = setTimeout(() => { dot.style.opacity = '0'; visible = false; }, 800);
  });
}

/* ── 5. Section scroll reveal ──────────────────────────────── */
if (!reduced) {
  const revealEls = document.querySelectorAll('.home-section, .page-section');
  revealEls.forEach(el => el.classList.add('reveal'));

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('revealed'); observer.unobserve(e.target); } });
  }, { threshold: 0.08 });

  revealEls.forEach(el => observer.observe(el));
}

/* ── 6. Typewriter for "Hi, I'm Joy." + intro paragraphs ──── */
if (!reduced) {
  const h1 = document.querySelector('h1');
  if (h1 && h1.textContent?.trim() === "Hi, I'm Joy.") {
    const sessionKey = 'typewriter-done';
    if (!sessionStorage.getItem(sessionKey)) {

      // inject blink keyframe once
      const blink = document.createElement('style');
      blink.textContent = '@keyframes blink { 0%,100%{opacity:1} 50%{opacity:0} }';
      document.head.appendChild(blink);

      // find the .flow div that immediately follows h1, get its paragraphs
      const flowDiv = h1.parentElement?.querySelector('.flow');
      const introParagraphs = flowDiv
        ? Array.from(flowDiv.querySelectorAll('p')) as HTMLElement[]
        : [];
      introParagraphs.forEach(p => { p.style.opacity = '0'; });

      // helper: type a string into an element, return promise when done
      function typeInto(el: HTMLElement, text: string, speed = 28): Promise<void> {
        return new Promise(resolve => {
          const cursor = document.createElement('span');
          cursor.textContent = '|';
          cursor.style.cssText = 'animation:blink 0.9s step-end infinite;font-weight:300;';
          el.appendChild(cursor);
          let i = 0;
          const tick = () => {
            if (i < text.length) {
              cursor.before(text[i++]);
              setTimeout(tick, speed + Math.random() * 20);
            } else {
              setTimeout(() => { cursor.remove(); resolve(); }, 600);
            }
          };
          tick();
        });
      }

      // type h1 first
      const h1Text = h1.textContent!;
      h1.textContent = '';
      await typeInto(h1, h1Text, 55);

      // then type each intro paragraph sequentially
      for (const p of introParagraphs) {
        const text = p.textContent ?? '';
        p.textContent = '';
        p.style.opacity = '1';
        await typeInto(p, text, 12);
      }

      sessionStorage.setItem(sessionKey, '1');
    }
  }
}
})();
</script>

<style is:global>
  @import "../styles/organic.css";
  @import "../styles/interactions.css";

  /* ── Scroll background blobs ── */
  .scroll-bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }

  .scroll-blob {
    position: absolute;
    border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%;
    filter: blur(90px);
    will-change: transform;
  }

  .scroll-blob-1 {
    width: 70vw; height: 70vw;
    background: rgba(93, 112, 82, 0.09);
    top: -20vh; left: -20vw;
  }

  .scroll-blob-2 {
    width: 60vw; height: 60vw;
    background: rgba(193, 140, 93, 0.08);
    top: 30vh; right: -15vw;
  }

  .scroll-blob-3 {
    width: 55vw; height: 55vw;
    background: rgba(214, 201, 168, 0.10);
    bottom: -10vh; left: 15vw;
  }

  .page-shell::before,
  .page-shell::after {
    display: none !important;
  }

  @media (min-width: 48rem) {
    .grid-projects-detail,
    .grid-writing {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .grid-projects-detail,
    .grid-writing {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
