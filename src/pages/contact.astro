---
import ContactCard from "../components/ContactCard.astro";
import { siteData } from "../data/site";
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title={`${siteData.name} | Contact`} description="Contact page">
  <section class="page-section">
    <div class="container split-layout">
      <div class="text-panel card">
        <p class="eyebrow">Contact</p>
        <h1>Say hello</h1>
        <div class="flow prose">
          <p>
            If something here resonated, I’d love to hear from you. Say hi, or book a virtual coffee chat — I’m always happy to connect.
          </p>
        </div>
      </div>

      <ContactCard />
    </div>
  </section>
</MainLayout>
