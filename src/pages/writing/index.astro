---
import { getCollection } from "astro:content";
import WritingCard from "../../components/WritingCard.astro";
import { siteData } from "../../data/site";
import MainLayout from "../../layouts/MainLayout.astro";

const posts = (await getCollection("writing", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<MainLayout title={`${siteData.name} | Blogs`} description="Blogs page">
  <section class="page-section">
    <div class="container">
      <p class="eyebrow">Blogs</p>
      <h1>Thinking out loud</h1>
      <p class="tagline">Books I'm sitting with, things I'm learning, life I'm reflecting on. Less polished, more honest. You're welcome to read over my shoulder.</p>
    </div>
  </section>

  <section class="page-section">
    <div class="container">
      <div class="grid grid-writing">
        {posts.map((post) => <WritingCard post={post} />)}
      </div>
    </div>
  </section>
</MainLayout>
