---
import { getCollection } from "astro:content";
import CalendlyBooking from "../components/CalendlyBooking.astro";
import ProjectCard from "../components/ProjectCard.astro";
import WritingCard from "../components/WritingCard.astro";
import { siteData } from "../data/site";
import { projects } from "../data/projects";
import MainLayout from "../layouts/MainLayout.astro";

const posts = (await getCollection("writing", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
).slice(0, 3);

const featuredProjects = projects.slice(0, 3);
---

<style is:global>
  .page-shell::before,
  .page-shell::after { display: none !important; }

  /* Scroll section dividers */
  .home-section {
    padding: 5rem 0;
    position: relative;
  }

  .home-section + .home-section {
    border-top: 1px solid var(--border);
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
  }

  .see-all {
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: var(--primary);
    text-decoration: none;
    white-space: nowrap;
    opacity: 0.8;
    transition: opacity 0.2s;
  }
  .see-all:hover { opacity: 1; }

  /* Experiments teaser card */
  .experiments-teaser {
    border-radius: 2rem 1.5rem 2.5rem 1.75rem;
    background: var(--accent);
    border: 1px solid var(--border);
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .experiments-teaser .exp-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .experiments-teaser .exp-chip {
    font-size: 0.8rem;
    font-family: var(--font-body);
    padding: 0.3rem 0.85rem;
    border-radius: 99px;
    background: var(--bg);
    border: 1px solid var(--border);
    color: var(--muted-foreground);
  }

  /* Contact teaser — full container width like other sections */
  .contact-teaser {
    width: 100%;
  }

  /* Active nav on scroll */
  .nav-list a.scroll-active {
    background: var(--accent);
    color: var(--foreground);
  }

  /* About motion video — same as about.astro */
  .about-canvas {
    min-height: 52vh;
    position: relative;
    overflow: hidden;
    padding-top: 5rem;
  }
  .about-motion-zone {
    width: 100%;
    min-height: 44vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .motion-video-wrap {
    position: relative;
    width: min(1000px, 100vw);
    -webkit-mask-image:
      linear-gradient(to right,  transparent 0%, black 14%, black 86%, transparent 100%),
      linear-gradient(to bottom, transparent 0%, black 12%, black 88%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to right,  transparent 0%, black 14%, black 86%, transparent 100%),
      linear-gradient(to bottom, transparent 0%, black 12%, black 88%, transparent 100%);
    mask-composite: intersect;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.5s ease;
    opacity: 0.88;
  }
  .motion-video-wrap:hover { transform: scale(1.04); opacity: 1; }
  .motion-video { display: block; width: 100%; height: auto; mix-blend-mode: multiply; }

  @media (prefers-reduced-motion: reduce) {
    .motion-video-wrap { transition: none; }
    .motion-video-wrap:hover { transform: none; }
  }
</style>

<MainLayout title="Joy" description={siteData.description}>

  <!-- ── ABOUT ──────────────────────────────────────── -->
  <section id="about" class="about-canvas blob-wrap">
    <div class="blob blob-moss" style="width:26rem;height:26rem;top:-8rem;right:-4rem;opacity:0.16;"></div>
    <div class="blob blob-clay" style="width:18rem;height:18rem;bottom:-4rem;left:-6rem;opacity:0.12;border-radius:40% 60% 70% 30% / 40% 50% 60% 50%;"></div>
    <div class="blob blob-sand" style="width:14rem;height:14rem;top:20%;left:15%;opacity:0.18;border-radius:50% 50% 30% 70%;"></div>
    <div class="container about-motion-zone" style="position:relative;z-index:1;">
      <div class="motion-video-wrap">
        <video class="motion-video" src="/about-motion.mp4" autoplay loop muted playsinline aria-hidden="true"></video>
      </div>
    </div>
  </section>

  <section class="home-section" style="padding-top:3.5rem;">
    <div class="container">
      <p class="eyebrow">About</p>
      <h1 style="margin-bottom:1.75rem;">Hi, I'm Joy.</h1>
      <div class="flow" style="max-width:38rem;">
        {siteData.about.slice(1).map((p) => <p class="tagline" style="font-style:normal;">{p}</p>)}
      </div>
    </div>
  </section>

  <!-- ── PROJECTS ───────────────────────────────────── -->
  <section id="projects" class="home-section">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">Projects</p>
          <h2>Things I'm making</h2>
        </div>
        <a href="/projects/" class="see-all">See all →</a>
      </div>
      <div class="grid grid-projects-detail">
        {featuredProjects.map((project) => <ProjectCard project={project} variant="detail" />)}
      </div>
    </div>
  </section>

  <!-- ── BLOGS ─────────────────────────────────────── -->
  <section id="blogs" class="home-section">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">Blogs</p>
          <h2>Thinking out loud</h2>
        </div>
        <a href="/writing/" class="see-all">See all →</a>
      </div>
      <div class="grid grid-writing">
        {posts.map((post) => <WritingCard post={post} />)}
      </div>
    </div>
  </section>

  <!-- ── EXPERIMENTS ────────────────────────────────── -->
  <section id="experiments" class="home-section">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">Tiny Experiments</p>
          <h2>Things I am trying</h2>
        </div>
        <a href="/atlas/" class="see-all">Explore atlas →</a>
      </div>
      <div class="experiments-teaser">
        <p class="tagline" style="font-style:normal; max-width:34rem;">
          A concept by Anne-Laure Le Cunff that has quietly become my philosophy.
          Small bets, low stakes, high curiosity — just questions I decided to live
          out for a while and see what happens.
        </p>
        <div class="exp-chips">
          {["Morning walk", "Daily sketch", "Read 10 pages", "One-paragraph journal",
            "Daily flashcards", "Single-task block", "Phone-free breakfast", "Sleep wind-down"].map(name =>
            <span class="exp-chip">{name}</span>
          )}
        </div>
        <a href="/atlas/" class="btn">Open the atlas →</a>
      </div>
    </div>
  </section>

  <!-- ── CONTACT ────────────────────────────────────── -->
  <section id="contact" class="home-section">
    <div class="container">
      <div class="contact-teaser">
        <p class="eyebrow">Contact</p>
        <h2>Say hello</h2>
        <p class="tagline" style="font-style:normal; margin-top:1rem;">
          If something here resonated, I'd love to hear from you. Say hi, or book a
          virtual coffee chat — I'm always happy to connect.
        </p>
        <div style="margin-top:2rem; display:flex; gap:1rem; flex-wrap:wrap;">
          <a href={`mailto:${siteData.contact.email}`} class="btn">Send an email</a>
          <a href={siteData.contact.linkedin} class="btn btn-ghost">LinkedIn</a>
        </div>
        <CalendlyBooking />
      </div>
    </div>
  </section>

</MainLayout>

<script>
  // Smooth scroll for anchor links in nav when on home page
  document.querySelectorAll('a[href^="/#"], a[href^="#"]').forEach(link => {
    link.addEventListener("click", (e) => {
      const href = (link as HTMLAnchorElement).getAttribute("href")!;
      const id = href.replace(/^\/?#/, "");
      const target = document.getElementById(id);
      if (target) {
        e.preventDefault();
        target.scrollIntoView({ behavior: "smooth", block: "start" });
      }
    });
  });

  // Scroll spy — highlight nav item for visible section
  const sections = document.querySelectorAll("section[id]");
  const navLinks = document.querySelectorAll(".nav-list a");

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navLinks.forEach((a) => a.classList.remove("scroll-active"));
          const active = document.querySelector(`.nav-list a[href="/#${entry.target.id}"], .nav-list a[href="/"][data-section="${entry.target.id}"]`);
          active?.classList.add("scroll-active");
        }
      });
    },
    { rootMargin: "-40% 0px -55% 0px" }
  );

  sections.forEach((s) => observer.observe(s));
</script>
