---
import { getCollection } from "astro:content";
import CalendlyBooking from "../components/CalendlyBooking.astro";
import ExperimentsAtlas from "../components/ExperimentsAtlas";
import ProjectCard from "../components/ProjectCard.astro";
import WritingCard from "../components/WritingCard.astro";
import { siteData } from "../data/site";
import { projects } from "../data/projects";
import MainLayout from "../layouts/MainLayout.astro";
import { themes, type ThemeId } from "../data/themes";

const posts = (await getCollection("writing", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
).slice(0, 4);

const featuredProjects = projects;

const expEntries = await getCollection("experiments");
const themeMap = new Map<ThemeId, { id: string; title: string; linkedExperiments: string[] }[]>();
for (const e of expEntries) {
  const cat = e.data.category as ThemeId;
  if (!themeMap.has(cat)) themeMap.set(cat, []);
  themeMap.get(cat)!.push({ id: e.id, title: e.data.title, linkedExperiments: e.data.linkedExperiments });
}
const atlasThemes = (Object.keys(themes) as ThemeId[]).map((id) => ({
  id, name: themes[id].name, color: themes[id].color, experiments: themeMap.get(id) ?? [],
}));
---

<style is:global>
  .page-shell::before,
  .page-shell::after { display: none !important; }

  /* Scroll section dividers */
  .home-section {
    padding: 5rem 0;
    position: relative;
  }

  .home-section + .home-section {
    border-top: 1px solid var(--border);
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
  }

  .see-all {
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: var(--primary);
    text-decoration: none;
    white-space: nowrap;
    opacity: 0.8;
    transition: opacity 0.2s;
  }
  .see-all:hover { opacity: 1; }

  /* Experiments teaser card */
  .experiments-teaser {
    border-radius: 2rem 1.5rem 2.5rem 1.75rem;
    background: var(--accent);
    border: 1px solid var(--border);
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .experiments-teaser .exp-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .experiments-teaser .exp-chip {
    font-size: 0.8rem;
    font-family: var(--font-body);
    padding: 0.3rem 0.85rem;
    border-radius: 99px;
    background: var(--bg);
    border: 1px solid var(--border);
    color: var(--muted-foreground);
  }

  /* Blogs — faded video background */
  .blogs-canvas {
    position: relative;
    overflow: hidden;
  }

  .blogs-video-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .blogs-video-bg video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.18;
    mix-blend-mode: multiply;
  }

  .blogs-canvas .container {
    position: relative;
    z-index: 1;
  }

  /* Contact — form + stones layout */
  .contact-teaser {
    width: 100%;
    display: grid;
    gap: 3rem;
    align-items: end;
    margin-top: 2rem;
  }

  @media (min-width: 48rem) {
    .contact-teaser {
      grid-template-columns: 1fr auto;
    }
  }

  /* Pebbles video in contact section */
  .contact-stones-wrap {
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
  }

  .contact-pebbles-video {
    display: block;
    width: 280px;
    border-radius: 1rem;
    mix-blend-mode: multiply;
    opacity: 0.92;
    pointer-events: none;
  }

  /* Active nav on scroll */
  .nav-list a.scroll-active {
    background: var(--accent);
    color: var(--foreground);
  }

  /* About hero — video background with floating card */
  .about-canvas {
    position: relative;
    min-height: 100vh;
  }

  .about-video-bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.5s ease;
    opacity: 1;
  }


  .motion-video-wrap {
    position: relative;
    width: 100vw;
    height: 100vh;
  }
  .motion-video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: translateZ(0);
    will-change: transform;
    backface-visibility: hidden;
  }

  .about-content {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: flex-start;
    padding: 70vh 1rem 20vh;
  }

  .about-card {
    width: min(50%, 28rem);
    background: rgba(255, 255, 255, 0.94);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 2rem 2rem 2.25rem;
    box-shadow: 0 8px 40px -8px rgba(44, 44, 36, 0.12);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    position: sticky;
    top: 6rem;
  }

  .about-card .eyebrow {
    margin-bottom: 0.6rem;
  }

  .about-card h1 {
    font-size: clamp(1.6rem, 3.5vw, 2.4rem);
    margin-bottom: 1rem;
  }

  .about-card p {
    font-size: 0.9rem;
    line-height: 1.65;
    margin-top: 0.6rem;
  }

  @media (max-width: 47.9rem) {
    .about-card {
      width: 100%;
      position: static;
    }
    .about-content {
      justify-content: center;
      padding: 4rem 1rem 4rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .motion-video-wrap { transition: none; }
  }
</style>

<MainLayout title="Joy" description={siteData.description}>

  <!-- ── ABOUT ──────────────────────────────────────── -->
  <section id="about" class="about-canvas">
    <div class="about-video-bg">
      <div class="motion-video-wrap">
        <video class="motion-video" src="/boat-rocking.mp4" autoplay loop muted playsinline preload="auto" aria-hidden="true"></video>
      </div>
    </div>
    <div class="about-content">
      <div class="about-card">
        <p class="eyebrow">About</p>
        <h1>Hi, I'm Joy.</h1>
        {siteData.about.slice(1).map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <!-- ── PROJECTS ───────────────────────────────────── -->
  <section id="projects" class="home-section zoom-section">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">Projects</p>
          <h2>Things I'm making</h2>
          <p class="tagline" style="font-style:normal; max-width:none;">Building, making, or figuring out. Some finished, most mid-process. It will look a little nonlinear — that's kind of the point.</p>
        </div>
        <a href="/projects/" class="see-all">See all →</a>
      </div>
      <div class="grid grid-projects-detail">
        {featuredProjects.map((project) => <ProjectCard project={project} variant="detail" />)}
      </div>
    </div>
  </section>

  <!-- ── BLOGS ─────────────────────────────────────── -->
  <section id="blogs" class="home-section zoom-section">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">Blogs</p>
          <h2>Thinking out loud</h2>
          <p class="tagline" style="font-style:normal; max-width:none;">Books I'm sitting with, things I'm learning, life I'm reflecting on. Less polished, more honest. You're welcome to read over my shoulder.</p>
        </div>
        <a href="/writing/" class="see-all">See all →</a>
      </div>
      <div class="grid grid-writing">
        {posts.map((post) => <WritingCard post={post} />)}
      </div>
    </div>
  </section>

  <!-- ── EXPERIMENTS ────────────────────────────────── -->
  <section id="experiments" class="home-section zoom-section">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">Tiny Experiments</p>
          <h2>Things I am trying</h2>
          <p class="tagline" style="font-style:normal; max-width:none;">Tiny experiments — a concept by Anne-Laure Le Cunff that has quietly become my philosophy. Small bets, low stakes, high curiosity. Just questions I decided to live out for a while and see what happens.</p>
        </div>
        <a href="/atlas/" class="see-all">See all →</a>
      </div>
      <div style="border-radius:2rem;border:1px solid var(--border);background:rgba(251,248,242,0.92);padding:1rem;box-shadow:0 8px 32px rgba(24,23,21,0.05);">
        <ExperimentsAtlas themes={atlasThemes} client:load />
      </div>
    </div>
  </section>

  <!-- ── CONTACT ────────────────────────────────────── -->
  <section id="contact" class="home-section zoom-section">
    <div class="container">
      <p class="eyebrow">Contact</p>
      <h2>Say hello</h2>
      <p class="tagline" style="font-style:normal; max-width:none; margin-top:1rem;">
        If something here resonated, I'd love to hear from you. Say hi, or book a
        virtual coffee chat — I'm always happy to connect.
      </p>
      <div class="contact-teaser">
        <CalendlyBooking />
        <div class="contact-stones-wrap">
          <video
            class="contact-pebbles-video"
            src="/contact-pebbles.mp4"
            autoplay loop muted playsinline
            aria-hidden="true"
          ></video>
        </div>
      </div>
    </div>
  </section>

</MainLayout>

<script>
  // Unmute hero video on first user interaction (browser autoplay requires muted for autostart)
  const heroVideo = document.querySelector<HTMLVideoElement>('.motion-video');
  if (heroVideo) {
    const unmute = () => {
      heroVideo.muted = false;
      document.removeEventListener('click', unmute);
      document.removeEventListener('keydown', unmute);
      document.removeEventListener('touchstart', unmute);
    };
    document.addEventListener('click', unmute);
    document.addEventListener('keydown', unmute);
    document.addEventListener('touchstart', unmute, { passive: true });
  }

  // Fade fixed video out as user scrolls past the about section
  const videoBg = document.querySelector<HTMLElement>('.about-video-bg');
  const aboutSection = document.querySelector<HTMLElement>('#about');
  if (videoBg && aboutSection) {
    const updateVideoOpacity = () => {
      const aboutBottom = aboutSection.getBoundingClientRect().bottom;
      const fadeStart = window.innerHeight * 0.6;
      const fadeEnd = -window.innerHeight * 0.2;
      const opacity = Math.max(0, Math.min(1, (aboutBottom - fadeEnd) / (fadeStart - fadeEnd)));
      videoBg.style.opacity = String(opacity);
    };
    let rafVideo: number;
    window.addEventListener('scroll', () => {
      cancelAnimationFrame(rafVideo);
      rafVideo = requestAnimationFrame(updateVideoOpacity);
    }, { passive: true });
    updateVideoOpacity();
  }

  // Smooth scroll for anchor links in nav when on home page
  document.querySelectorAll('a[href^="/#"], a[href^="#"]').forEach(link => {
    link.addEventListener("click", (e) => {
      const href = (link as HTMLAnchorElement).getAttribute("href")!;
      const id = href.replace(/^\/?#/, "");
      const target = document.getElementById(id);
      if (target) {
        e.preventDefault();
        target.scrollIntoView({ behavior: "smooth", block: "start" });
      }
    });
  });

  // Scroll spy — highlight nav item for visible section
  const sections = document.querySelectorAll("section[id]");
  const navLinks = document.querySelectorAll(".nav-list a");

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navLinks.forEach((a) => a.classList.remove("scroll-active"));
          const active = document.querySelector(`.nav-list a[href="/#${entry.target.id}"], .nav-list a[href="/"][data-section="${entry.target.id}"]`);
          active?.classList.add("scroll-active");
        }
      });
    },
    { rootMargin: "-40% 0px -55% 0px" }
  );

  sections.forEach((s) => observer.observe(s));

  // Scroll zoom — zoom-in each section as it enters the viewport
  const zoomSections = document.querySelectorAll<HTMLElement>('.zoom-section');
  const zoomObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          zoomObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.12 }
  );
  zoomSections.forEach((el) => zoomObserver.observe(el));
</script>
