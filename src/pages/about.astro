---
import { siteData } from "../data/site";
import MainLayout from "../layouts/MainLayout.astro";
---

<style is:global>
  .page-shell::before,
  .page-shell::after { display: none !important; }

  /* About page open layout */
  .about-canvas {
    min-height: 52vh;
    position: relative;
    overflow: hidden;
    padding-top: 5rem;
  }

  .about-motion-zone {
    width: 100%;
    min-height: 44vh;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Motion video — edge-free, blended */
  .motion-video-wrap {
    position: relative;
    width: min(1000px, 100vw);
    /* Fade all 4 edges, sharp centre — intersect horizontal + vertical fades */
    -webkit-mask-image:
      linear-gradient(to right,  transparent 0%,  black 14%, black 86%, transparent 100%),
      linear-gradient(to bottom, transparent 0%,  black 12%, black 88%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to right,  transparent 0%,  black 14%, black 86%, transparent 100%),
      linear-gradient(to bottom, transparent 0%,  black 12%, black 88%, transparent 100%);
    mask-composite: intersect;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1),
                opacity 0.5s ease;
    opacity: 0.88;
  }

  .motion-video-wrap:hover {
    transform: scale(1.04);
    opacity: 1;
  }

  .motion-video {
    display: block;
    width: 100%;
    height: auto;
    mix-blend-mode: multiply;
  }

  @media (prefers-reduced-motion: reduce) {
    .motion-video-wrap { transition: none; }
    .motion-video-wrap:hover { transform: none; }
  }
</style>

<MainLayout title={`${siteData.name} | About`} description="About page">

  <!-- Open motion canvas -->
  <section class="about-canvas blob-wrap">
    <div class="blob blob-moss"  style="width:26rem;height:26rem;top:-8rem;right:-4rem;opacity:0.16;"></div>
    <div class="blob blob-clay"  style="width:18rem;height:18rem;bottom:-4rem;left:-6rem;opacity:0.12;border-radius:40% 60% 70% 30% / 40% 50% 60% 50%;"></div>
    <div class="blob blob-sand"  style="width:14rem;height:14rem;top:20%;left:15%;opacity:0.18;border-radius:50% 50% 30% 70%;"></div>

    <div class="container about-motion-zone" style="position:relative;z-index:1;">
      <div class="motion-video-wrap">
        <video
          class="motion-video"
          src="/about-motion.mp4"
          autoplay
          loop
          muted
          playsinline
          aria-hidden="true"
        ></video>
      </div>
    </div>
  </section>

  <!-- About text — no card, no frame -->
  <section class="page-section" style="padding-top:3.5rem;">
    <div class="container">
      <p class="eyebrow">About</p>
      <h1 style="margin-bottom:1.75rem;">Hi, I'm Joy.</h1>

      <div class="flow prose" style="max-width:38rem;">
        {siteData.about.slice(1).map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>

</MainLayout>
