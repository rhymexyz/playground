---
import { siteData } from "../data/site";
import MainLayout from "../layouts/MainLayout.astro";
---

<style is:global>
  .page-shell::before,
  .page-shell::after { display: none !important; }

  /* About page open layout */
  .about-canvas {
    min-height: 38vh;
    position: relative;
    overflow: hidden;
  }

  .about-motion-zone {
    width: 100%;
    min-height: 32vh;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Motion video */
  .motion-video-wrap {
    position: relative;
    width: min(560px, 92vw);
    border-radius: 1.5rem 1.25rem 1.75rem 1.25rem;
    overflow: hidden;
    box-shadow: 0 8px 40px rgba(60, 50, 30, 0.13);
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1),
                box-shadow 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .motion-video-wrap:hover {
    transform: scale(1.03) translateY(-4px);
    box-shadow: 0 20px 60px rgba(60, 50, 30, 0.22);
  }

  .motion-video-wrap::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(ellipse at 60% 40%, rgba(255,255,255,0.08) 0%, transparent 70%);
    opacity: 0;
    transition: opacity 0.45s ease;
    pointer-events: none;
  }

  .motion-video-wrap:hover::after {
    opacity: 1;
  }

  .motion-video {
    display: block;
    width: 100%;
    height: auto;
    border-radius: inherit;
  }

  @media (prefers-reduced-motion: reduce) {
    .motion-video-wrap { transition: none; }
    .motion-video-wrap:hover { transform: none; }
  }
</style>

<MainLayout title={`${siteData.name} | About`} description="About page">

  <!-- Open motion canvas -->
  <section class="about-canvas blob-wrap">
    <div class="blob blob-moss"  style="width:26rem;height:26rem;top:-8rem;right:-4rem;opacity:0.16;"></div>
    <div class="blob blob-clay"  style="width:18rem;height:18rem;bottom:-4rem;left:-6rem;opacity:0.12;border-radius:40% 60% 70% 30% / 40% 50% 60% 50%;"></div>
    <div class="blob blob-sand"  style="width:14rem;height:14rem;top:20%;left:15%;opacity:0.18;border-radius:50% 50% 30% 70%;"></div>

    <div class="container about-motion-zone" style="position:relative;z-index:1;">
      <div class="motion-video-wrap">
        <video
          class="motion-video"
          src="/about-motion.mp4"
          autoplay
          loop
          muted
          playsinline
          aria-hidden="true"
        ></video>
      </div>
    </div>
  </section>

  <!-- About text — no card, no frame -->
  <section class="page-section" style="padding-top:3.5rem;">
    <div class="container">
      <p class="eyebrow">About</p>
      <h1 style="margin-bottom:1.75rem;">{siteData.name}</h1>

      <div class="flow prose" style="max-width:38rem;">
        {siteData.about.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>

</MainLayout>
