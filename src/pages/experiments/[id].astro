---
import MainLayout from "../../layouts/MainLayout.astro";
import { getCollection, render } from "astro:content";
import { themes } from "../../data/themes";
import { projects } from "../../data/projects";

export async function getStaticPaths() {
  const experiments = await getCollection("experiments");
  return experiments.map((e) => ({ params: { id: e.id } }));
}

const { id } = Astro.params;
const experiments = await getCollection("experiments");
const entry = experiments.find((e) => e.id === id);
if (!entry) return Astro.redirect("/atlas");

const exp = entry.data;
const theme = themes[exp.category];

// Related content
const allExps = await getCollection("experiments");
const linkedExps = exp.linkedExperiments
  .map((lid) => allExps.find((e) => e.id === lid))
  .filter(Boolean);

const allPosts = await getCollection("writing");
const linkedPosts = (exp.linkedPosts ?? [])
  .map((pid) => allPosts.find((p) => p.id === pid || p.id === pid + ".md"))
  .filter(Boolean);

const linkedProjects = (exp.linkedProjects ?? [])
  .map((slug) => projects.find((p) => p.slug === slug))
  .filter(Boolean);

const hasRelated = linkedExps.length > 0 || linkedPosts.length > 0 || linkedProjects.length > 0;

// Current iteration
const currentUpdates = [...(exp.updates ?? [])].sort((a, b) => a.date.valueOf() - b.date.valueOf());

// Past iterations (oldest → newest)
const pastIterations = [...(exp.iterations ?? [])].sort(
  (a, b) => a.startDate.valueOf() - b.startDate.valueOf()
);
const totalRounds = pastIterations.length + 1;

const { Content: Description } = await render(entry);

const statusLabel: Record<string, string> = {
  active: "Active", completed: "Completed", paused: "Paused", released: "Released",
};
const statusDot: Record<string, string> = {
  active: "#5D7052", completed: "#4a6c8c", paused: "#9a7a3a", released: "#7a4a8c",
};
---

<style is:global>
  .page-shell::before,
  .page-shell::after { display: none !important; }
</style>

<MainLayout title={`${exp.title} | Tiny Experiments`} description={entry.body?.slice(0,160) ?? ''}>
  <section class="page-section blob-wrap">
    <div class="blob blob-moss" style={`width:22rem;height:22rem;top:-6rem;right:-4rem;opacity:0.15;background:${theme.color};`}></div>
    <div class="blob blob-sand" style="width:16rem;height:16rem;bottom:0;left:-4rem;opacity:0.18;border-radius:50% 50% 30% 70%;"></div>

    <div class="container" style="position:relative;z-index:1;max-width:48rem;">

      <a href="/atlas" style="display:inline-flex;align-items:center;gap:0.4rem;font-size:0.85rem;color:var(--muted-foreground);text-decoration:none;margin-bottom:2.25rem;font-weight:500;transition:color 200ms;"
        onmouseover="this.style.color='var(--primary)'" onmouseout="this.style.color='var(--muted-foreground)'">
        ← Back to atlas
      </a>

      <!-- Header card -->
      <div style={`border-radius:2rem 1.5rem 2.25rem 1.75rem;background:${theme.color};padding:2.5rem 2.5rem 2rem;margin-bottom:1.25rem;border:1px solid rgba(44,44,36,0.08);box-shadow:0 8px 32px -8px rgba(44,44,36,0.12);position:relative;overflow:hidden;`}>
        <div style="position:absolute;width:14rem;height:14rem;top:-5rem;right:-3rem;background:rgba(255,255,255,0.25);border-radius:60% 40% 50% 50% / 50% 60% 40% 50%;filter:blur(30px);pointer-events:none;"></div>
        <p class="eyebrow" style="color:rgba(44,44,36,0.55);">{theme.name}</p>
        <h1 style="font-size:clamp(1.8rem,5vw,3rem);margin:0 0 1rem;color:#2C2C24;line-height:1.1;max-width:none;">{exp.title}</h1>
        <div style="color:rgba(44,44,36,0.65);max-width:34rem;margin:0;font-size:1.05rem;line-height:1.65;font-family:var(--font-body);">
          <Description />
        </div>
        <div style="display:flex;flex-wrap:wrap;gap:1rem;align-items:center;margin-top:1.5rem;">
          <span style={`display:inline-flex;align-items:center;gap:0.4rem;padding:0.35rem 0.9rem;border-radius:9999px;background:rgba(255,255,255,0.55);font-size:0.78rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:${statusDot[exp.status]};border:1px solid rgba(44,44,36,0.1);`}>
            <span style={`width:6px;height:6px;border-radius:50%;background:${statusDot[exp.status]};display:inline-block;`}></span>
            {statusLabel[exp.status]}
          </span>
        </div>
      </div>

      <!-- Past iterations (Round 1, Round 2, …) -->
      {pastIterations.map((iter, idx) => {
        const iterUpdates = [...(iter.updates ?? [])].sort((a, b) => a.date.valueOf() - b.date.valueOf());
        const roundNum = idx + 1;
        const iterOutput = iter.output ?? exp.output;
        const iterLoot = iter.loot ?? exp.loot;
        return (
          <div class="card" style="border-radius:1.75rem 2rem 2rem 1.75rem;overflow:hidden;margin-bottom:1.25rem;opacity:0.78;">

            <!-- Round label + date range -->
            <div style="padding:1.25rem 2rem;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;gap:1rem;background:var(--muted);">
              <span style="font-size:0.75rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:var(--muted-foreground);">Round {roundNum}</span>
              <span style="font-size:0.82rem;color:var(--muted-foreground);font-family:var(--font-body);">
                {iter.startDate.toISOString().slice(0,10)} → {iter.endDate.toISOString().slice(0,10)}
              </span>
            </div>

            <!-- Updates -->
            {iterUpdates.length > 0 && (
              <div style="padding:1.5rem 2rem;border-bottom:1px solid var(--border);">
                <p class="eyebrow" style="margin-bottom:1.25rem;">Updates</p>
                <div style="position:relative;">
                  <div style={`position:absolute;left:7px;top:6px;bottom:0;width:1.5px;background:${theme.color};opacity:0.4;`}></div>
                  <div style="display:flex;flex-direction:column;gap:1.25rem;">
                    {iterUpdates.map((u) => {
                      const dateStr = u.date.toLocaleDateString("en-US", { month: "short", day: "numeric", timeZone: "UTC" });
                      return (
                        <div style="display:grid;grid-template-columns:1rem 1fr;gap:0 1.25rem;align-items:start;">
                          <div style={`width:${u.milestone ? "16px" : "10px"};height:${u.milestone ? "16px" : "10px"};border-radius:50%;background:${u.milestone ? theme.color : "var(--muted)"};border:${u.milestone ? `2px solid rgba(44,44,36,0.2)` : `1.5px solid ${theme.color}`};margin-top:4px;position:relative;left:${u.milestone ? "-3px" : "0"};flex-shrink:0;`}></div>
                          <div>
                            <span style="font-size:0.78rem;color:var(--muted-foreground);font-family:var(--font-body);">{dateStr}</span>
                            <p style="font-size:0.92rem;font-weight:600;color:var(--foreground);margin:0.15rem 0 0.25rem;font-family:var(--font-display);">{u.title}</p>
                            <p style="font-size:0.88rem;color:var(--muted-foreground);line-height:1.65;font-family:var(--font-body);margin:0;">{u.body}</p>
                          </div>
                        </div>
                      );
                    })}
                  </div>
                </div>

                <!-- Reflection inline after updates -->
                {iter.reflection && (
                  <div style="margin-top:1.75rem;padding-top:1.5rem;border-top:1px solid var(--border);">
                    <p class="eyebrow" style="margin-bottom:0.6rem;">Reflection</p>
                    <p style="margin:0;color:var(--foreground);line-height:1.75;font-size:0.95rem;font-style:italic;">{iter.reflection}</p>
                  </div>
                )}
              </div>
            )}

            <!-- Reflection without updates -->
            {!iterUpdates.length && iter.reflection && (
              <div style="padding:1.5rem 2rem;border-bottom:1px solid var(--border);">
                <p class="eyebrow" style="margin-bottom:0.6rem;">Reflection</p>
                <p style="margin:0;color:var(--foreground);line-height:1.75;font-size:0.95rem;font-style:italic;">{iter.reflection}</p>
              </div>
            )}

            <!-- Output + Loot -->
            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(14rem,1fr));">
              <div style="padding:1.4rem 2rem;">
                <p class="eyebrow" style="margin-bottom:0.5rem;">Output</p>
                <p style="margin:0;color:var(--foreground);line-height:1.65;font-size:0.92rem;">{iterOutput}</p>
              </div>
              <div style="padding:1.4rem 2rem;border-left:1px solid var(--border);background:var(--muted);">
                <p class="eyebrow" style="margin-bottom:0.5rem;">Loot</p>
                <p style="margin:0;color:var(--foreground);line-height:1.65;font-style:italic;font-size:0.92rem;">{iterLoot}</p>
              </div>
            </div>

          </div>
        );
      })}

      <!-- Current iteration card -->
      <div class="card" style="border-radius:1.75rem 2rem 2rem 1.75rem;overflow:hidden;margin-bottom:1.5rem;">

        <!-- Round label + date range (only when multi-round) -->
        {totalRounds > 1 && (
          <div style="padding:1.25rem 2rem;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;gap:1rem;">
            <span style="font-size:0.75rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:var(--muted-foreground);">Round {totalRounds}</span>
            <span style="font-size:0.82rem;color:var(--muted-foreground);font-family:var(--font-body);">
              {exp.startDate.toISOString().slice(0,10)} → {exp.endDate.toISOString().slice(0,10)}
            </span>
          </div>
        )}

        {exp.background && (
          <div style="padding:1.75rem 2rem;border-bottom:1px solid var(--border);">
            <p class="eyebrow" style="margin-bottom:0.6rem;">Background</p>
            <p style="margin:0;color:var(--foreground);line-height:1.75;font-size:0.95rem;">{exp.background}</p>
          </div>
        )}

        <!-- Updates -->
        {currentUpdates.length > 0 && (
          <div style="padding:1.75rem 2rem;border-bottom:1px solid var(--border);">
            <p class="eyebrow" style="margin-bottom:1.5rem;">Updates</p>
            <div style="position:relative;">
              <div style={`position:absolute;left:7px;top:6px;bottom:0;width:1.5px;background:${theme.color};opacity:0.5;`}></div>
              <div style="display:flex;flex-direction:column;gap:1.5rem;">
                {currentUpdates.map((u) => {
                  const dateStr = u.date.toLocaleDateString("en-US", { month: "short", day: "numeric", timeZone: "UTC" });
                  return (
                    <div style="display:grid;grid-template-columns:1rem 1fr;gap:0 1.25rem;align-items:start;">
                      <div style={`width:${u.milestone ? "16px" : "10px"};height:${u.milestone ? "16px" : "10px"};border-radius:50%;background:${u.milestone ? theme.color : "var(--muted)"};border:${u.milestone ? `2px solid rgba(44,44,36,0.2)` : `1.5px solid ${theme.color}`};margin-top:4px;position:relative;left:${u.milestone ? "-3px" : "0"};flex-shrink:0;`}></div>
                      <div>
                        <span style="font-size:0.8rem;color:var(--muted-foreground);font-family:var(--font-body);">{dateStr}</span>
                        <p style="font-size:0.95rem;font-weight:600;color:var(--foreground);margin:0.2rem 0 0.3rem;font-family:var(--font-display);">{u.title}</p>
                        <p style="font-size:0.9rem;color:var(--muted-foreground);line-height:1.65;font-family:var(--font-body);margin:0;">{u.body}</p>
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>

            <!-- Reflection inline after updates -->
            {exp.reflection && (
              <div style="margin-top:2rem;padding-top:1.5rem;border-top:1px solid var(--border);">
                <p class="eyebrow" style="margin-bottom:0.6rem;">Reflection</p>
                <p style="margin:0;color:var(--foreground);line-height:1.75;font-size:0.95rem;font-style:italic;">{exp.reflection}</p>
              </div>
            )}
          </div>
        )}

        <!-- Reflection without updates -->
        {!currentUpdates.length && exp.reflection && (
          <div style="padding:1.75rem 2rem;border-bottom:1px solid var(--border);">
            <p class="eyebrow" style="margin-bottom:0.6rem;">Reflection</p>
            <p style="margin:0;color:var(--foreground);line-height:1.75;font-size:0.95rem;font-style:italic;">{exp.reflection}</p>
          </div>
        )}

        <!-- Output + Loot -->
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(14rem,1fr));border-top:1px solid var(--border);">
          <div style="padding:1.5rem 2rem;">
            <p class="eyebrow" style="margin-bottom:0.6rem;">Output</p>
            <p style="margin:0;color:var(--foreground);line-height:1.65;font-size:0.95rem;">{exp.output}</p>
          </div>
          <div style="padding:1.5rem 2rem;border-left:1px solid var(--border);background:var(--muted);">
            <p class="eyebrow" style="margin-bottom:0.6rem;">Loot</p>
            <p style="margin:0;color:var(--foreground);line-height:1.65;font-style:italic;font-size:0.95rem;">{exp.loot}</p>
          </div>
        </div>

        {hasRelated && (
          <div style="padding:1.5rem 2rem;border-top:1px solid var(--border);">
            <p class="eyebrow" style="margin-bottom:1rem;">Related Content</p>
            <div style="display:flex;flex-wrap:wrap;gap:0.55rem;">
              {linkedExps.map((le) => le && (
                <a href={`/experiments/${le.id}`}
                  style={`display:inline-flex;align-items:center;padding:0.45rem 1rem;border-radius:9999px;background:${themes[le.data.category].color};border:1px solid rgba(44,44,36,0.08);font-size:0.85rem;font-weight:600;color:#2C2C24;text-decoration:none;transition:transform 200ms ease;`}
                  onmouseover="this.style.transform='scale(1.04)'"
                  onmouseout="this.style.transform=''">
                  {le.data.title}
                </a>
              ))}
              {linkedPosts.map((post) => post && (
                <a href={`/writing/${post.id.replace(/\.md$/, '')}/`}
                  style="display:inline-flex;align-items:center;padding:0.45rem 1rem;border-radius:9999px;background:var(--accent);border:1px solid rgba(44,44,36,0.08);font-size:0.85rem;font-weight:600;color:#2C2C24;text-decoration:none;transition:transform 200ms ease;"
                  onmouseover="this.style.transform='scale(1.04)'"
                  onmouseout="this.style.transform=''">
                  {post.data.title}
                </a>
              ))}
              {linkedProjects.map((proj) => proj && (
                <a href={`/projects/${proj.slug}/`}
                  style="display:inline-flex;align-items:center;padding:0.45rem 1rem;border-radius:9999px;background:var(--muted);border:1px solid rgba(44,44,36,0.08);font-size:0.85rem;font-weight:600;color:#2C2C24;text-decoration:none;transition:transform 200ms ease;"
                  onmouseover="this.style.transform='scale(1.04)'"
                  onmouseout="this.style.transform=''">
                  {proj.title}
                </a>
              ))}
            </div>
          </div>
        )}

      </div>

      <a href="/atlas" class="button-link" style="margin-top:0.5rem;">View all experiments →</a>
    </div>
  </section>
</MainLayout>
